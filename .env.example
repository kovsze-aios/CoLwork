# ─────────────────────────────────────────────────────────────
# CoLwork — environment template
# Copy this file to `.env` and fill in your own values.
# Never commit `.env` — it is gitignored.
# ─────────────────────────────────────────────────────────────

# === LinkedIn (optional, only for Playwright auto-apply flows) ===
LINKEDIN_EMAIL=your.email@example.com
LINKEDIN_PASSWORD=replace-me

# === DeepSeek (primary LLM, OpenAI-compatible API) ============
# Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === Kimi / Moonshot (optional fallback LLM) ==================
KIMI_API_KEY=sk-replace-me
KIMI_BASE_URL=https://api.moonshot.cn/v1

# === Playwright runtime =======================================
HEADLESS=false
COOKIES_FILE=./data/cookies.json

# === Email reporting (optional) ===============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.smtp.user@example.com
SMTP_PASS=replace-me
REPORT_EMAIL_TO=your.email@example.com

# === n8n Cloud orchestration (optional) =======================
# Self-host or use Cloud — workflows are in `data/n8n_workflows/`.
# Deploy them with: node src/scripts/deploy_n8n_workflows.js
N8N_API_KEY=eyJhbGciOi...replace-me
N8N_BASE_URL=https://your-n8n-host.example.com/api/v1
N8N_WEBHOOK_URL=https://your-n8n-host.example.com

# === Google Sheets / Docs destinations ========================
GOOGLE_SHEET_ID=replace-with-your-sheet-id
GOOGLE_DOCS_ID=replace-with-your-doc-id

# === Operator metadata ========================================
HQ_LOCATION=City, Country
HQ_TIMEZONE=Europe/Warsaw
